
QWidget {
    background-color: #0f172a;
    color: #f8fafc;
    font-size: 13px;
}

QMainWindow {
    background-color: #0f172a;
}

QTableWidget {
    border: 1px solid #334155;
    border-radius: 8px;
    gridline-color: #1f2a3a;
    background-color: #0f172a;
    color: #f8fafc;
    selection-background-color: #1e40af;
}

QHeaderView::section {
    background-color: #0b1220;
    color: #94a3b8;
    padding: 6px;
    border: 0px;
    border-bottom: 1px solid #334155;
}

QTableWidget::item {
    padding: 6px;
    border: 0px;
}

QTableCornerButton::section {
    background-color: #0b1220;
    border: 0px;
}
