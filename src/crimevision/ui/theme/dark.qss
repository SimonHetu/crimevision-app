/* === COLOR SYSTEM ===
MAIN_BG       #0f172a
CARD_BG       #1e293b
ACCENT        #7c3aed
ACCENT_LIGHT  #a78bfa
ACCENT_DARK   #5b21b6
TEXT_MAIN     #f8fafc
*/



QWidget {
    background-color: #0f172a;
    color: #f8fafc;
    font-size: 13px;
}

QMainWindow {
    background-color: #0f172a;
}

QTableWidget {
    border: 1px solid #334155;
    border-radius: 8px;
    gridline-color: #1f2a3a;
    background-color: #0f172a;
    color: #f8fafc;
    selection-background-color: #1e40af;
}

QHeaderView::section {
    background-color: #0b1220;
    color: #94a3b8;
    padding: 6px;
    border: 0px;
    border-bottom: 1px solid #334155;
}

QTableWidget::item {
    padding: 6px;
    border: 0px;
}

QTableCornerButton::section {
    background-color: #0b1220;
    border: 0px;
}


/* ===== Bouttons ===== */

QPushButton {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 12px;
    color: #f8fafc;
}

QPushButton:hover {
    border: 1px solid #3b82f6;
    background-color: #1e3a8a;
}

QPushButton:pressed {
    border: 1px solid #60a5fa;
    background-color: #1d4ed8;
}


QPushButton:checked {
    border: 1px solid #3b82f6;
    background-color: #1e3a8a;
}



QListWidget {
    background-color: #0b1220;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 6px;
}

QListWidget::item {
    padding: 6px;
}

/* ===== Login (hierarchy) ===== */
#loginTitle {
    font-size: 20px;
    font-weight: 700;
    color: #f8fafc;
}

#loginSubtitle {
    font-size: 11px;
    font-weight: 500;
    color: #64748b;
    margin-top: 2px;
}